# cp .env.example .env  후 값을 채우세요. .env 는 .gitignore 에 있습니다.

# 앱 접속 비밀번호 (iPad 에서 한 번 입력하면 30일간 유지)
APP_PASSWORD=
# 세션 서명용 비밀키 — 아래 명령으로 생성:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── NVIDIA NIM (주 엔진) ──
# 키 발급: https://build.nvidia.com  →  모델 선택  →  "Get API Key"
NIM_API_KEY=
# 아래는 2026-07-29 기준으로 실제 엔드포인트에 존재함을 확인한 ID 입니다.
# (NIM 카탈로그는 회전이 빨라 퇴역한 ID 가 많습니다. 404=없음, 410=퇴역)
#   meta/llama-3.3-70b-instruct              ← 기본값. 비추론 모델이라 첫 토큰이 빠르고
#                                              "뜻:/문맥:" 2줄 형식을 잘 지킵니다.
#   openai/gpt-oss-120b                      한국어가 아쉬우면 먼저 시도해볼 것
#   mistralai/mistral-large-2-instruct       다국어 강함
#   nvidia/llama-3.3-nemotron-super-49b-v1
#   openai/gpt-oss-20b                       가장 가볍고 빠름
# 주의: 추론(reasoning/thinking) 계열은 첫 토큰까지 수 초 걸려서
#       단어 탭 반응성을 망칩니다. 피하세요.
NIM_MODEL=meta/llama-3.3-70b-instruct

# 질문 탭 기본 모델. 여기는 탭 반응성과 무관해서 더 좋은(무거운) 모델을 쓴다.
# 앱 설정에서 사용자가 다른 모델로 바꿀 수 있고, 고를 수 있는 목록은
# server/index.js 의 ASK_MODELS 에 있다. (여기 값은 그 목록에 있어야 설정 화면과 맞는다)
# 2026-07-29 에 같은 한국어 질문으로 재본 값:
#   deepseek-ai/deepseek-v4-pro          ← 기본값. 첫 응답 0.8초, 설명이 가장 정확
#   nvidia/nemotron-3-super-120b-a12b    전체 2초로 가장 빠름. 답이 짧음
#   minimaxai/minimax-m3                 가장 꼼꼼함. 첫 응답 8초
#   openai/gpt-oss-120b                  빠르지만 마크다운을 섞음
#   mistralai/mistral-medium-3.5-128b    첫 응답이 20초를 넘길 때가 있음
# 피할 것: deepseek-v4-flash, z-ai/glm-5.2, stepfun-ai/step-3.7-flash
#          — 전부 추론 계열이라 첫 응답까지 80초 넘게 걸렸다.
NIM_ASK_MODEL=deepseek-ai/deepseek-v4-pro

# ── Gemini (폴백) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

PORT=8787
