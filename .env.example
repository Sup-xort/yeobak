# cp .env.example .env  후 값을 채우세요. .env 는 .gitignore 에 있습니다.
# 기본값은 server/index.js 머리에 있습니다.

# 접속 비밀번호 — 반드시 숫자 6자리 (6자리가 차면 자동 제출된다)
APP_PASSWORD=
# 세션 서명 키:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 쉬는 시간 기준 로그인 유지 시간 (기본 4)
SESSION_HOURS=

# ── AI 키: 최소 하나. 모델은 server/models.js 가 스스로 찾는다 ──
NIM_API_KEY=
NIM_BASE_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# 비우면 자동 선택. 채우면 그 모델을 맨 앞에 둔다
TAP_MODEL=
ASK_MODEL=

# 단축어·공유 시트용 받은편지함 토큰 (POST /api/inbox)
INBOX_TOKEN=
# 서버 안(루프백)에서만 통하는 개발용 토큰
DEV_TOKEN=

# data/ 위치 — systemd ReadWritePaths 밖으로 옮기면 쓰기가 막힌다
DATA_DIR=
PORT=8787
